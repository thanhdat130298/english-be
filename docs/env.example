## English Learning API (Sprint 1) — environment variables

# Server
PORT=3000
NODE_ENV=development
# CORS: comma-separated origins (leave empty or omit to allow all origins)
# Example: CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_ORIGIN=

# Database (PostgreSQL)
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english?schema=public
DATABASE_URL=

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# DeepL
DEEPL_API_KEY=
# Optional: override if needed (free vs pro endpoints)
DEEPL_API_URL=https://api-free.deepl.com/v2/translate






